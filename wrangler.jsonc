{
  "name": "2450-maverick",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    { "binding": "DATA", "id": "17b9dc394f2345f79dc5ad071cc3b3d9" }
  ],
  // Lets the site email feedback to Brad (address kept in the FEEDBACK_TO secret, not in this public repo)
  "send_email": [ { "name": "MAILER" } ],
  // Free daily AI allowance powers "Tell Mav" setup
  "ai": { "binding": "AI" },
  // Every 30 min: refresh news, fires, warnings, holidays and watch the council field page. Every 5 min: send queued phone alerts
  "triggers": { "crons": [ "*/30 * * * *", "*/5 * * * *" ] },
  // Secrets (set in Cloudflare dashboard, never in this repo): ADMIN_KEY, FEEDBACK_TO, FUEL_KEY, FUEL_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  // ---- Byron Bay: same engine, own town settings and own data. Deploy with: npx wrangler deploy --env byron
  "env": {
    "byron": {
      "name": "2481-maverick",
      "vars": { "REGION": "2481" },
      "routes": [ { "pattern": "2481-maverick.live", "custom_domain": true } ],
      "kv_namespaces": [ { "binding": "DATA", "id": "b41681c8ad1c43fd98c48d1fe761c243" } ],
      "send_email": [ { "name": "MAILER" } ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [ "*/30 * * * *", "*/5 * * * *" ] }
    },
    "bellingen": {
      "name": "2454-maverick",
      "vars": { "REGION": "2454" },
      "routes": [ { "pattern": "2454-maverick.live", "custom_domain": true } ],
      "kv_namespaces": [ { "binding": "DATA", "id": "11b90efb8d4241b189a0aba5e024d7e0" } ],
      "send_email": [ { "name": "MAILER" } ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [ "*/30 * * * *", "*/5 * * * *" ] }
    }
  }
}
