{
  "name": "2450-maverick",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    { "binding": "DATA", "id": "17b9dc394f2345f79dc5ad071cc3b3d9" }
  ],
  // Lets the site email feedback to Brad (address kept in the FEEDBACK_TO secret, not in this public repo)
  "send_email": [ { "name": "MAILER" } ],
  // Free daily AI allowance powers "Tell Mav" setup
  "ai": { "binding": "AI" },
  // Every 30 min: refresh news, fires, warnings, holidays and watch the council field page. Every 5 min: send queued phone alerts
  "triggers": { "crons": [ "*/5 * * * *" ] },
  // Secrets (set in Cloudflare dashboard, never in this repo): AC_URL, AC_KEY, ADMIN_KEY, FEEDBACK_TO, FUEL_KEY, FUEL_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GRAVATAR_API_KEY
  // ---- Byron Bay: same engine, own town settings and own data. Deploy with: npx wrangler deploy --env byron
  "env": {
    "byron": {
      "name": "2481-maverick",
      "vars": { "REGION": "2481" },
      "routes": [ { "pattern": "2481-maverick.live", "custom_domain": true } ],
      "kv_namespaces": [ { "binding": "DATA", "id": "b41681c8ad1c43fd98c48d1fe761c243" } ],
      "send_email": [ { "name": "MAILER" } ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [ "*/5 * * * *" ] }
    },
    "bellingen": {
      "name": "2454-maverick",
      "vars": { "REGION": "2454" },
      "routes": [ { "pattern": "2454-maverick.live", "custom_domain": true } ],
      "kv_namespaces": [ { "binding": "DATA", "id": "11b90efb8d4241b189a0aba5e024d7e0" } ],
      "send_email": [ { "name": "MAILER" } ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [ "*/5 * * * *" ] }
    },
    "tweed": {
      "name": "2485-maverick",
      "vars": { "REGION": "2485" },
      "routes": [ { "pattern": "2485-maverick.live", "custom_domain": true } ],
      "kv_namespaces": [ { "binding": "DATA", "id": "88b7ca32e9af428ea7f89be4eb4fc0b2" } ],
      "send_email": [ { "name": "MAILER" } ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [ "*/5 * * * *" ] }
    },
    "taree": {
      "name": "2430-maverick",
      "vars": { "REGION": "2430" },
      "routes": [ { "pattern": "2430-maverick.live", "custom_domain": true } ],
      "kv_namespaces": [ { "binding": "DATA", "id": "46257678f2034da0aa3ac90a743c823e" } ],
      "send_email": [ { "name": "MAILER" } ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [ "*/5 * * * *" ] }
    },
    "armidale": {
      "name": "2350-maverick",
      "vars": { "REGION": "2350" },
      "routes": [ { "pattern": "2350-maverick.live", "custom_domain": true } ],
      "kv_namespaces": [ { "binding": "DATA", "id": "e5a1bcd842cd4063a4b520c14d48ec53" } ],
      "send_email": [ { "name": "MAILER" } ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [ "*/5 * * * *" ] }
    },
    "portmac": {
      "name": "2444-maverick",
      "vars": { "REGION": "2444" },
      "routes": [ { "pattern": "2444-maverick.live", "custom_domain": true } ],
      "kv_namespaces": [ { "binding": "DATA", "id": "c9b5e850715a444f8b25d91e3bceb8ca" } ],
      "send_email": [ { "name": "MAILER" } ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": [ "*/5 * * * *" ] }
    }
  }
}
